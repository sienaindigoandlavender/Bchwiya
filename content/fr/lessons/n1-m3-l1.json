        "kind": "svg",
        "component": "Sign",
        "props": {
          "preset": "depassement-interdit"
        }
      }
    },
    {
      "type": "text",
      "body": "Une flèche barrée : interdiction de tourner dans ce sens.",
      "media": {
        "kind": "svg",
