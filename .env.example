# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only. Building phase: the app has no login and uses this key on the server
# to read and write Zahra's progress. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: pin the learner profile id. Otherwise the first "learner" profile is used.
# BCHWIYA_LEARNER_ID=

# Seed script: who gets which role
ADMIN_EMAIL=jacqueline@example.com
LEARNER_EMAIL=zahra@example.com
